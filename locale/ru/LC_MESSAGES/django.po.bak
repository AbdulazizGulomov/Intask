# =========================

msgid "Kerakli bo‘limni tanlang"
msgstr "Выберите нужный раздел"

msgid "Ish qidiraman"
msgstr "Ищу работу"

msgid "Tez daromad olish uchun bu yerga."
msgstr "Для быстрого заработка — сюда."

msgid "Ish beruvchiman"
msgstr "Я работодатель"

msgid "Tez ishchi kerak bo‘lsa, bu yerga."
msgstr "Если нужен работник — сюда."


